# --- ROS 2 recorded data ----------------------------------------------------
# rosbags grow to gigabytes in minutes. Keep them out; publish a download
# link or a small sample in the relevant project README instead.
*.bag
*.db3
*.db3-shm
*.db3-wal
*.mcap
rosbag2_*/

# --- Datasets and trained models -------------------------------------------
# No trailing slash on purpose: these paths are symlinks to external storage
# (/mnt/i), and a `dir/` pattern does not match a symlink — git would happily
# commit the link itself, which is useless to a cloner and leaks local paths.
06_dados
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.feather
*.pkl
*.pickle
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.tflite
*.engine
*.pb

# --- RL training runs / experiment tracking --------------------------------
runs/
outputs/
checkpoints/
wandb/
mlruns/
lightning_logs/
tensorboard/
events.out.tfevents.*
03_trilha_c_sim/treinos

# --- Simulation output ------------------------------------------------------
# MuJoCo scenes (.xml/.mjcf) ARE versioned; renders and captures are not.
03_trilha_c_sim/videos
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.gif.tmp

# --- Real-time / EtherCAT measurement dumps --------------------------------
# Raw cyclictest / latency histograms are large and machine-specific.
# Commit the summarised results (CSV/plot) under 04_trilha_d_rt/medicoes/,
# not the raw dumps.
04_trilha_d_rt/medicoes/raw/
*.hist
cyclictest_*.txt

# --- Portfolio media --------------------------------------------------------
# Heavy source media stays out; small optimised assets used by the READMEs
# live in docs/assets/ and are whitelisted below.
05_portfolio/midia
!docs/assets/**

# --- Local backups ----------------------------------------------------------
90_backup_repo
*.bak
*.orig
*.rej
*.tmp
*~

# --- Personal / career material (NEVER publish) ----------------------------
# CVs, job applications and private notes about companies.
07_carreira
**/curriculo
**/candidaturas
*.cv.pdf

