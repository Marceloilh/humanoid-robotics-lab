*.pfx
id_rsa*
id_ed25519*
credentials.json
secrets.yaml
secrets.yml
.netrc

# --- Editors / IDE ----------------------------------------------------------
# .vscode/settings.json and .clangd are shared on purpose (clangd + ROS 2
