# ---------------------------------------------------------------------------
# humanoid-robotics-lab
#
# Policy: source, configuration and documentation are versioned.
# Build output, simulator artifacts, datasets, model weights, media and
# anything personal are not.
# ---------------------------------------------------------------------------

# --- ROS 2 / colcon workspace output ---------------------------------------
# Regenerated by `colcon build`; contains absolute paths of this machine.
build/
install/
log/
logs/
.colcon/
.catkin_tools/
COLCON_IGNORE
AMENT_IGNORE
compile_commands.json
.cache/

# --- C / C++ build ----------------------------------------------------------
*.o
*.obj
*.lo
*.slo
*.a
*.la
*.lib
*.so
*.so.*
*.dylib
*.dll
*.d
*.gch
*.pch
*.out
*.app
*.i*86
*.x86_64
*.hex

