.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.vscode/c_cpp_properties.json
.vscode/browse.vc.db*
.vscode/ipch/
.idea/
*.swp
*.swo
*.sublime-workspace
.clangd/
.cache/clangd/

